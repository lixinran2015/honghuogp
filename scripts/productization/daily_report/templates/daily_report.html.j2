<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; line-height: 1.8; color: #1f2937; max-width: 720px; margin: 0 auto;">

  <h2 style="font-size: 22px; font-weight: 700; color: #111827; margin: 0 0 16px 0; border-left: 4px solid #f59e0b; padding-left: 12px;">A股短线龙头日报 · {{ trade_date }}</h2>

  <div style="background: #fffbeb; border: 1px solid #fcd34d; border-radius: 8px; padding: 16px; margin-bottom: 24px;">
    <h3 style="font-size: 16px; font-weight: 700; color: #b45309; margin: 0 0 12px 0;">📌 今日核心观点</h3>
    <ul style="margin: 0; padding-left: 20px; color: #78350f;">
      <li><b>情绪状态</b>：{{ emotion_cycle_description|default('-') }}（涨停 {{ limit_up_count|default('-') }} 家 / 跌停 {{ limit_down_count|default('-') }} 家）</li>
      <li><b>市场高度</b>：最高连板 {{ max_continuous_limit|default('-') }} 板，涨跌比 {{ advance_decline_ratio|default('-') }}</li>
      <li><b>今日要点</b>：{{ summary|default('-') }}</li>
      <li><b>明日策略</b>：详见下方操作清单</li>
    </ul>
  </div>

  <h3 style="font-size: 17px; font-weight: 700; color: #111827; margin: 24px 0 12px 0;">一、情绪周期判断</h3>
  <p style="margin: 0 0 12px 0;">{{ emotion_cycle_description|default('-') }}</p>
  {% if emotion_progress %}
  <div style="margin-bottom: 16px; padding: 12px; background: #f9fafb; border-radius: 6px;">
    <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-bottom: 8px;">
      {% for c in emotion_progress.cycles %}
        {% if loop.index0 == emotion_progress.current_index %}
        <span style="padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; background: #f59e0b; color: #fff;">{{ c }}</span>
        {% else %}
        <span style="padding: 4px 10px; border-radius: 12px; font-size: 12px; color: #6b7280; background: #e5e7eb;">{{ c }}</span>
        {% endif %}
        {% if not loop.last %}
        <span style="color: #d1d5db; font-size: 12px;">→</span>
        {% endif %}
      {% endfor %}
    </div>
    <div style="font-size: 13px; color: #4b5563;">🌡️ {{ emotion_progress.thermometer }}</div>
  </div>
  {% endif %}
  <ul style="margin: 0 0 24px 0; padding-left: 20px; color: #4b5563;">
    <li>涨停家数：<b>{{ limit_up_count|default('-') }}</b> {% if yesterday_emotion %}<span style="color: #9ca3af; font-size: 13px;">{{ fmt_change(limit_up_count, yesterday_emotion.limit_up_count, '家') }}</span>{% endif %}</li>
    <li>跌停家数：<b>{{ limit_down_count|default('-') }}</b> {% if yesterday_emotion %}<span style="color: #9ca3af; font-size: 13px;">{{ fmt_change(limit_down_count, yesterday_emotion.limit_down_count, '家') }}</span>{% endif %}</li>
    <li>市场最高连板：<b>{{ max_continuous_limit|default('-') }} 板</b> {% if yesterday_emotion %}<span style="color: #9ca3af; font-size: 13px;">{{ fmt_change(max_continuous_limit, yesterday_emotion.max_continuous_limit, '板') }}</span>{% endif %}</li>
    <li>涨跌比：<b>{{ advance_decline_ratio|default('-') }}</b> {% if yesterday_emotion %}<span style="color: #9ca3af; font-size: 13px;">{{ fmt_change(advance_decline_ratio, yesterday_emotion.advance_decline_ratio) }}</span>{% endif %}<br/><span style="color: #9ca3af; font-size: 12px;">（涨跌比<1 表示下跌家数多于上涨家数）</span></li>
  </ul>

  {% if market_height_leader %}
  <h3 style="font-size: 17px; font-weight: 700; color: #111827; margin: 24px 0 12px 0;">🔺 市场最高标</h3>
  <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 12px 16px; margin-bottom: 16px;">
    <div style="font-weight: 600; font-size: 15px; color: #7f1d1d;">
      {{ market_height_leader.name }} ({{ market_height_leader.ts_code }}) · <span style="color: #dc2626;">{{ market_height_leader.continuous_limit }} 连板</span>
    </div>
    <div style="font-size: 13px; color: #991b1b; margin-top: 4px;">
      当前市场连板高度标杆，仅作情绪参考，不作为买入建议
    </div>
  </div>
  {% endif %}

  <h3 style="font-size: 17px; font-weight: 700; color: #111827; margin: 24px 0 12px 0;">二、🔥 Top {{ top_stocks|length }} 空间龙头</h3>
  {% if top_stocks %}
  <table style="width: 100%; border-collapse: collapse; font-size: 14px; margin-bottom: 12px;">
    <thead>
      <tr style="background: #f3f4f6;">
        <th style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: left;">股票</th>
        <th style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: left;">板块</th>
        <th style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">等级</th>
        <th style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">总分</th>
        <th style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">评分溢价</th>
        <th style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">5日涨幅</th>
      </tr>
    </thead>
    <tbody>
      {% for stock in top_stocks %}
      <tr>
        <td style="padding: 10px 8px; border: 1px solid #e5e7eb;">
          <div style="font-weight: 600;">{{ stock.name }}</div>
          {% if stock.badges %}
          <div style="margin-top: 4px;">
            {% for b in stock.badges %}
            <span style="display: inline-block; padding: 2px 6px; border-radius: 4px; font-size: 11px; margin-right: 4px; color: {{ b.color }}; background: {{ b.bg }}; border: 1px solid {{ b.color }}33;">{{ b.text }}</span>
            {% endfor %}
          </div>
          {% endif %}
        </td>
        <td style="padding: 10px 8px; border: 1px solid #e5e7eb;">{{ stock.sector_short|default('-') }}</td>
        <td style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">{{ stock.grade_emoji|default('-') }} {{ stock.grade|default('-') }}</td>
        <td style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">{{ stock.total_score|default('-') }}</td>
        <td style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center; {% if stock.expected_return != '-' %}{% if stock.expected_return|float > 0 %}color: #ef4444;{% elif stock.expected_return|float < 0 %}color: #22c55e;{% endif %}{% endif %}">{{ stock.expected_return|default('-') }}%</td>
        <td style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center; {% if stock.change_pct_5d != '-' %}{% if stock.change_pct_5d|float > 0 %}color: #ef4444;{% elif stock.change_pct_5d|float < 0 %}color: #22c55e;{% endif %}{% endif %}">{{ stock.change_pct_5d|default('-') }}%</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="font-size: 12px; color: #9ca3af; margin-bottom: 16px;">
    *评分溢价：基于 LSTM-MAB 模型的综合评分溢价，非次日预测涨幅。
  </div>

  <div style="background: #f9fafb; border-left: 3px solid #d1d5db; padding: 12px 16px; margin-bottom: 12px; color: #374151;">
    <b>简评</b><br/>
    {% for stock in top_stocks %}
    • <b>{{ stock.name }}</b>：{{ stock.brief_comment|default('综合评价良好') }}<br/>
    {% endfor %}
  </div>

  {% else %}
  <p style="color: #6b7280; margin-bottom: 24px;">今日暂无空间龙头数据。</p>
  {% endif %}

  <h3 style="font-size: 17px; font-weight: 700; color: #111827; margin: 24px 0 12px 0;">三、技术形态触发池</h3>
  {% if signal_stocks %}
    {% for stock in signal_stocks %}
    <div style="margin-bottom: 12px; padding: 12px; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 6px;">
      <div style="font-weight: 600; margin-bottom: 6px;">{{ stock.name }} ({{ stock.ts_code }}) · {{ stock.sector_short|default('-') }}</div>
      <div style="color: #4b5563; font-size: 14px;">形态：{{ stock.signal_description|default('-') }}<br/>强度：{{ stock.strength_score|default('-') }} | 质量：{{ stock.quality|default('-') }}<br/>AI 评分：{{ stock.grade|default('-') }} ({{ stock.total_score|default('-') }} 分)</div>
    </div>
    {% endfor %}
  {% else %}
    <p style="margin: 0 0 8px 0;">今日未监测到明显的技术形态触发信号。</p>
    {% if recent_win_rate is not none %}
    <p style="margin: 0 0 8px 0; color: #4b5563; font-size: 14px;"><b>胜率提示</b>：{% if recent_win_rate.rate == 100.0 %}近期 {{ recent_win_rate.count }} 只样本全部录得正收益，胜率仅供参考{% else %}近期推荐胜率 <b>{{ recent_win_rate.rate }}%</b>（样本 {{ recent_win_rate.count }} 只）{% endif %}，空仓等待也是策略的一部分。</p>
    {% endif %}
    <p style="margin: 0; color: #4b5563; font-size: 14px;"><b>解读</b>：情绪高涨期 + 买点信号空窗，说明市场以持筹博弈为主，新启动机会较少，明日重点观察早盘分歧后的承接力度，避免盲目追高。</p>
  {% endif %}

  <h3 style="font-size: 17px; font-weight: 700; color: #111827; margin: 24px 0 12px 0;">四、明日操作清单</h3>
  <div style="background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; margin-bottom: 24px;">
    {% for item in strategy_list %}
      {% if item.type == 'do' %}
      <div style="margin-bottom: 8px; color: #166534; font-size: 14px;">✅ {{ item.text }}</div>
      {% else %}
      <div style="margin-bottom: 8px; color: #991b1b; font-size: 14px;">❌ {{ item.text }}</div>
      {% endif %}
    {% endfor %}
  </div>

  <h3 style="font-size: 17px; font-weight: 700; color: #111827; margin: 24px 0 12px 0;">五、📊 历史推荐追踪</h3>
  {% if past_recommendations %}
    {% for day in past_recommendations %}
    <div style="margin-bottom: 16px;">
      <div style="font-size: 15px; font-weight: 600; color: #374151; margin-bottom: 4px;">{{ day.trade_date[5:] }} 推荐</div>
      <div style="font-size: 13px; color: #6b7280; margin-bottom: 8px;">前第 5 个交易日推荐股票截至今日的表现</div>
      <table style="width: 100%; border-collapse: collapse; font-size: 14px; margin-bottom: 12px;">
        <thead>
          <tr style="background: #f3f4f6;">
            <th style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: left;">股票</th>
            <th style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: left;">板块</th>
            <th style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">推荐日评分</th>
            <th style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">至今涨幅</th>
          </tr>
        </thead>
        <tbody>
          {% for stock in day.stocks %}
          <tr>
            <td style="padding: 10px 8px; border: 1px solid #e5e7eb;">{{ stock.name }}</td>
            <td style="padding: 10px 8px; border: 1px solid #e5e7eb;">{{ stock.sector_short|default('-') }}</td>
            <td style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">{{ stock.total_score|default('-') }}</td>
            <td style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center; {% if stock.change_pct is not none %}{% if stock.change_pct > 0 %}color: #ef4444;{% elif stock.change_pct < 0 %}color: #22c55e;{% endif %}{% endif %}">
              {% if stock.change_pct is not none %}{{ '%+.2f'|format(stock.change_pct) }}%{% else %}-{% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endfor %}
  {% else %}
    <p style="color: #6b7280; margin-bottom: 24px;">暂无足够历史数据生成推荐追踪。</p>
  {% endif %}

  <div style="border-top: 1px solid #e5e7eb; padding-top: 16px; margin-top: 24px; color: #9ca3af; font-size: 13px;">
    <b>免责声明</b>：本内容仅为数据整理与个人研究记录，不构成任何投资建议。股市有风险，入市需谨慎。
  </div>

</div>
