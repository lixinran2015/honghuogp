industry_cycles:
  rising:
  - name: 电子
    keywords:
    - 电子
    net_cash_ratio: 0.01
    cash_receipt_ratio: 0.5
    reason: 半导体/消费电子国产替代
  - name: 国防军工
    keywords:
    - 国防军工
    net_cash_ratio: 0.01
    cash_receipt_ratio: 0.5
    reason: 订单增长，回款有季节性
  - name: 农林牧渔
    keywords:
    - 农林牧渔
    net_cash_ratio: 0.01
    cash_receipt_ratio: 0.5
