defaults:
  net_cash_ratio: 0.6
  cash_receipt_ratio: 0.7
  reason: 通用阈值，适用于汽车、机械设备等
special_rules:
  rising_with_high_growth:
    revenue_growth_threshold: 20.0
    discount_factor: 0.9
    reason: 快速扩张期且营收高增，可放宽10%
  declining_strict:
    min_net_cash_ratio: 0.9
    require_positive_cashflow: true
    reason: 下滑期风险高，必须现金流为正
industry_mapping:
  纺织服装: 纺织服饰
  商业贸易: 商贸零售
  C25石油、煤炭及其他燃料加工业: 石油石化
  B07石油和天然气开采业: 石油石化
  D46水的生产和供应业: 公用事业
  N77生态保护和环境治理业: 公用事业
  K70房地产业: 房地产
  J66货币金融服务: 银行
  J67资本市场服务: 银行
  J69其他金融业: 非银金融
