# 红火量化 - 前端（构建 + Nginx 托管）
FROM node:20-alpine AS builder

WORKDIR /app
COPY frontend-vue/package*.json ./
RUN npm ci
COPY frontend-vue/ .
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY frontend-vue/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
