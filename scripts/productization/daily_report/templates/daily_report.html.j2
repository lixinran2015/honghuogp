<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; line-height: 1.8; color: #1f2937; max-width: 720px; margin: 0 auto;">

  <h2 style="font-size: 22px; font-weight: 700; color: #111827; margin: 0 0 16px 0; border-left: 4px solid #f59e0b; padding-left: 12px;">A股短线龙头日报 · {{ trade_date }}</h2>

  <div style="background: #fffbeb; border: 1px solid #fcd34d; border-radius: 8px; padding: 16px; margin-bottom: 24px;">
    <h3 style="font-size: 16px; font-weight: 700; color: #b45309; margin: 0 0 12px 0;">📌 今日核心观点</h3>
    <ul style="margin: 0; padding-left: 20px; color: #78350f;">
      <li><b>情绪状态</b>：{{ emotion_cycle_description|default('-') }}（涨停 {{ limit_up_count|default('-') }} 家 / 跌停 {{ limit_down_count|default('-') }} 家）</li>
      <li><b>市场高度</b>：最高连板 {{ max_continuous_limit|default('-') }} 板，涨跌比 {{ advance_decline_ratio|default('-') }}</li>
      <li><b>今日要点</b>：{{ summary|default('-') }}</li>
      <li><b>明日策略</b>：{{ strategy|default('-') }}</li>
    </ul>
  </div>

  <h3 style="font-size: 17px; font-weight: 700; color: #111827; margin: 24px 0 12px 0;">一、情绪周期判断</h3>
  <p style="margin: 0 0 12px 0;">{{ emotion_cycle_description|default('-') }}</p>
  <ul style="margin: 0 0 24px 0; padding-left: 20px; color: #4b5563;">
    <li>涨停家数：<b>{{ limit_up_count|default('-') }}</b></li>
    <li>跌停家数：<b>{{ limit_down_count|default('-') }}</b></li>
    <li>市场最高连板：<b>{{ max_continuous_limit|default('-') }} 板</b></li>
    <li>涨跌比：<b>{{ advance_decline_ratio|default('-') }}</b></li>
  </ul>

  <h3 style="font-size: 17px; font-weight: 700; color: #111827; margin: 24px 0 12px 0;">二、🔥 Top {{ top_stocks|length }} 空间龙头</h3>
  {% if top_stocks %}
  <table style="width: 100%; border-collapse: collapse; font-size: 14px; margin-bottom: 12px;">
    <thead>
      <tr style="background: #f3f4f6;">
        <th style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: left;">股票</th>
        <th style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: left;">板块</th>
        <th style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">等级</th>
        <th style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">总分</th>
        <th style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">预期收益</th>
        <th style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">置信度</th>
        <th style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">5日涨幅</th>
      </tr>
    </thead>
    <tbody>
      {% for stock in top_stocks %}
      <tr>
        <td style="padding: 10px 8px; border: 1px solid #e5e7eb;">{{ stock.name }}</td>
        <td style="padding: 10px 8px; border: 1px solid #e5e7eb;">{{ stock.sector_short|default('-') }}</td>
        <td style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">{{ stock.grade_emoji|default('-') }} {{ stock.grade|default('-') }}</td>
        <td style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">{{ stock.total_score|default('-') }}</td>
        <td style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">{{ stock.expected_return|default('-') }}%</td>
        <td style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">{{ stock.confidence|default('-') }}%</td>
        <td style="padding: 10px 8px; border: 1px solid #e5e7eb; text-align: center;">{{ stock.change_pct_5d|default('-') }}%</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="background: #f9fafb; border-left: 3px solid #d1d5db; padding: 12px 16px; margin-bottom: 24px; color: #374151;">
    <b>简评</b><br/>
    {% for stock in top_stocks %}
    • <b>{{ stock.name }}</b>：{{ stock.brief_comment|default('综合评价良好') }}<br/>
    {% endfor %}
  </div>
  {% else %}
  <p style="color: #6b7280; margin-bottom: 24px;">今日暂无空间龙头数据。</p>
  {% endif %}

  <h3 style="font-size: 17px; font-weight: 700; color: #111827; margin: 24px 0 12px 0;">三、技术形态触发池</h3>
  {% if signal_stocks %}
    {% for stock in signal_stocks %}
    <div style="margin-bottom: 12px; padding: 12px; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 6px;">
      <div style="font-weight: 600; margin-bottom: 6px;">{{ stock.name }} ({{ stock.ts_code }}) · {{ stock.sectors[0] if stock.sectors else '-' }}</div>
      <div style="color: #4b5563; font-size: 14px;">形态：{{ stock.signal_description|default('-') }}<br/>强度：{{ stock.strength_score|default('-') }} | 质量：{{ stock.quality|default('-') }}<br/>AI 评分：{{ stock.grade|default('-') }} ({{ stock.total_score|default('-') }} 分)</div>
    </div>
    {% endfor %}
  {% else %}
    <p style="margin: 0 0 8px 0;">今日未监测到明显的技术形态触发信号。</p>
    <p style="margin: 0; color: #4b5563; font-size: 14px;"><b>解读</b>：情绪高涨期 + 买点信号空窗，说明市场以持筹博弈为主，新启动机会较少，明日重点观察早盘分歧后的承接力度，避免盲目追高。</p>
  {% endif %}

  <h3 style="font-size: 17px; font-weight: 700; color: #111827; margin: 24px 0 12px 0;">四、👀 次日跟踪名单（Top 6-10）</h3>
  {% if watchlist_excluding_top5 %}
  <ul style="margin: 0 0 24px 0; padding-left: 20px; color: #374151;">
    {% for stock in watchlist_excluding_top5 %}
    <li style="margin-bottom: 6px;">{{ stock.name }} ({{ stock.ts_code }}) · {{ stock.sector_short|default('-') }} · 等级 {{ stock.grade|default('-') }} ({{ stock.total_score|default('-') }} 分) · 5日涨幅 {{ stock.change_pct_5d|default('-') }}%</li>
    {% endfor %}
  </ul>
  {% else %}
  <p style="color: #6b7280; margin-bottom: 24px;">暂无新增跟踪标的。</p>
  {% endif %}

  <div style="border-top: 1px solid #e5e7eb; padding-top: 16px; margin-top: 24px; color: #9ca3af; font-size: 13px;">
    <b>免责声明</b>：本内容仅为数据整理与个人研究记录，不构成任何投资建议。股市有风险，入市需谨慎。
  </div>

</div>
