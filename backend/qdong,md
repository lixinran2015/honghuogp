## 五、程序判断流程图（伪代码逻辑）
```python
# 输入：单只股票的实时/历史行情数据（data字典，包含上述所有指标字段）
def is_just_started(data):
    # 1. 基础过滤：全部满足才继续
    basic_pass = (
        data["circulation_market_cap"] >= 50e8  # F1：流通市值≥50亿
        and data["today_turnover"] >= 10e8      # F2：当日成交额≥10亿
        and data["current_price"] >= data["ma60"]  # F3：站上60日线
        and data["trading_days_60d"] >= 50      # F4：近60日交易≥50天
    )
    if not basic_pass:
        return False
    
    # 2. 核心判定：全部满足才继续
    core_pass = (
        # C1：突破近60日关键阻力位且站稳
        (data["current_price"] >= data["high_60d"] * 0.95) 
        and (data["current_price"] <= data["high_60d"] * 1.05)
        and (data["close_price"] >= data["high_60d"] * 0.95)
        # C2：量能放大（量比≥1.5 + 换手率≥5%）
        and (data["today_turnover"] >= data["avg_turnover_20d"] * 1.5)
        and (data["turnover_rate"] >= 5.0)
        # C3：均线多头排列（5>10>20>60）
        and (data["ma5"] > data["ma10"] > data["ma20"] > data["ma60"])
        # C4：5日金叉10日
        and (data["ma5"] > data["ma10"])
        and (data["ma5_yesterday"] <= data["ma10_yesterday"])
    )
    if not core_pass:
        return False
    
    # 3. 辅助确认：至少满足1个
    assist_count = 0
    # A1：MACD金叉
    if (data["macd_dif"] > data["macd_dea"]) and (data["macd_dif_yesterday"] <= data["macd_dea_yesterday"]) and (data["macd_hist"] > 0):
        assist_count +=1
    # A2：KDJ金叉且J∈[50,70]
    if (data["kdj_j"] > data["kdj_k"]) and (data["kdj_j"] > data["kdj_d"]) and (50 <= data["kdj_j"] <=70):
        assist_count +=1
    # A3：RSI∈[50,70]
    if 50 <= data["rsi14"] <=70:
        assist_count +=1
    # A4：大单净流入>0且占比≥5%
    if (data["big_order_net_inflow"] > 0) and (data["big_order_net_inflow"] / data["today_turnover"] >= 0.05):
        assist_count +=1
    # A5：板块近5日涨≥3%（可选）
    if data.get("industry_5d_gain") >=3.0:
        assist_count +=1
    if assist_count < 1:
        return False
    
    # 4. 风险排除：全部不满足
    risk_pass = (
        # R1：近5日涨≤30%且近10日涨≤40%
        (data["gain_5d"] <=30.0) and (data["gain_10d"] <=40.0)
        # R2：当前价/MA60 ≤1.2
        and (data["current_price"] / data["ma60"] <=1.2)
        # R3：当日量能/近5日均量 ≥1.2
        and (data["today_turnover"] / data["avg_turnover_5d"] >=1.2)
        # R4：RSI≤75且KDJ_J≤80
        and (data["rsi14"] <=75) and (data["kdj_j"] <=80)
    )
    if not risk_pass:
        return False
    
    # 所有条件满足 → 判定为刚启动
    return True
```

